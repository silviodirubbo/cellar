{
  "name": "cellar-scripts",
  "version": "1.0.0",
  "private": true,
  "description": "Out-of-band scripts for Silvio's Cellar: daily tasting status sync and availability updater (GitHub Actions), data and link checks (Check workflow), image size table, Instagram Story renderer",
  "scripts": {
    "sync-status": "node sync-tasting-status.js",
    "update-availability": "node update-availability.js",
    "render-stories": "node render-stories.js",
    "image-sizes": "node image-sizes.js",
    "validate-data": "node validate-data.js",
    "check-links": "node check-links.js ../_site"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "playwright": "^1.56.0"
  },
  "optionalDependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/dm-mono": "^5.2.0"
  }
}
